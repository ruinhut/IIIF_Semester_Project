{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local contract subset derived from EPFL time-atlas-python 0.3.0 (not a team-issued schema)",
  "type": "object",
  "required": ["name", "type_in_file", "creation_time", "rde_objects"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "type_in_file": {"type": "array", "minItems": 1, "maxItems": 1},
    "creation_time": {"type": "string", "format": "date-time"},
    "related_dataset_slugs": {"type": "array", "items": {"type": "string"}},
    "rde_objects": {"type": "array", "minItems": 1}
  },
  "oneOf": [
    {"properties": {"type_in_file": {"const": ["dataset"]}, "rde_objects": {"items": {"$ref": "#/$defs/dataset"}}}},
    {"properties": {"type_in_file": {"const": ["historical_record"]}, "rde_objects": {"items": {"$ref": "#/$defs/hr"}}}},
    {"properties": {"type_in_file": {"const": ["observation"]}, "rde_objects": {"items": {"$ref": "#/$defs/obs"}}}},
    {"properties": {"type_in_file": {"const": ["area"]}, "rde_objects": {"items": {"$ref": "#/$defs/area"}}}}
  ],
  "$defs": {
    "uuid": {"type": "string", "format": "uuid"},
    "times": {
      "type": "object", "required": ["start_time", "end_time"],
      "properties": {"start_time": {"type": "string", "format": "date-time"}, "end_time": {"type": "string", "format": "date-time"}}
    },
    "dataset": {
      "allOf": [{"$ref": "#/$defs/times"}],
      "type": "object", "required": ["id", "rde_type", "slug", "name", "configuration", "sources", "has_areas"],
      "properties": {
        "id": {"$ref": "#/$defs/uuid"}, "rde_type": {"const": "dataset"}, "slug": {"type": "string"},
        "name": {"type": "object"}, "configuration": {"type": "object"},
        "sources": {"type": "array", "items": {"$ref": "#/$defs/uuid"}},
        "has_areas": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/uuid"}}
      }
    },
    "hr": {
      "allOf": [{"$ref": "#/$defs/times"}],
      "type": "object", "required": ["id", "rde_type", "dataset", "paradata", "has_observations", "metadata"],
      "properties": {
        "id": {"$ref": "#/$defs/uuid"}, "rde_type": {"const": "historical_record"}, "dataset": {"$ref": "#/$defs/uuid"},
        "paradata": {"enum": ["a", "m", "sa", "ai"]},
        "has_observations": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/uuid"}},
        "metadata": {"type": "object"}, "rights_attribution": {"type": ["string", "null"]}
      }
    },
    "obs": {
      "type": "object", "required": ["id", "rde_type", "historical_record", "geometry", "has_geometries"],
      "properties": {
        "id": {"$ref": "#/$defs/uuid"}, "rde_type": {"const": "observation"}, "historical_record": {"$ref": "#/$defs/uuid"},
        "geometry": {"type": "object", "required": ["type", "coordinates"], "properties": {
          "type": {"const": "Point"}, "coordinates": {"type": "array", "minItems": 2, "maxItems": 2,
            "prefixItems": [{"type": "number", "minimum": -180, "maximum": 180}, {"type": "number", "minimum": -90, "maximum": 90}]}
        }},
        "has_geometries": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/uuid"}},
        "part_of_point_of_interest": {"type": "null"}
      }
    },
    "area": {
      "type": "object", "required": ["id", "rde_type", "slug", "name", "geometry"],
      "properties": {
        "id": {"$ref": "#/$defs/uuid"}, "rde_type": {"const": "area"}, "slug": {"type": "string"}, "name": {"type": "object"},
        "geometry": {"type": "object", "required": ["type", "coordinates"], "properties": {"type": {"const": "Polygon"}, "coordinates": {"type": "array"}}}
      }
    }
  }
}
