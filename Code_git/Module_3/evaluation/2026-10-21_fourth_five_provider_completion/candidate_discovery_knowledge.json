        {
          "skill_id": "berlin-oai-ppn-identifiers-to-native-manifests",
          "type": "paginated_xml_identifiers_to_manifest_templates",
          "api_url": "https://oai.sbb.berlin/",
          "query_parameters": {
            "verb": "ListRecords",
            "metadataPrefix": "oai_dc"
          },
          "xml_namespaces": {
            "oai": "http://www.openarchives.org/OAI/2.0/"
          },
          "xml_record_path": ".//oai:record",
          "xml_identifier_path": "oai:header/oai:identifier",
          "identifier_pattern": "^oai:digital\\.staatsbibliothek-berlin\\.de:(?P<identifier>PPN[0-9X]+)$",
          "manifest_url_templates": [
            "https://content.staatsbibliothek-berlin.de/dc/{identifier}/manifest"
          ],
          "pagination": {
            "page_parameter": "",
            "page_size_parameter": "",
            "page_size": 50,
            "max_pages": 100,
            "next_token_path": ".//oai:resumptionToken",
            "token_keep_parameters": [
              "verb"
            ]
          },
          "max_identifiers": 5000,
          "coverage_note": "Public digitised-collections OAI identifier stream. OAI PPN strings can end in X; do not force numeric IDs. Resumption tokens are opaque even if their text already contains percent escapes.",
          "request_delay_seconds": 0.6
        }
      ]
    },
